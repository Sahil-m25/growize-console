{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growize.internal/contracts/money.received.json",
  "title": "money.received",
  "x-direction": "outside \u2192 investor",
  "x-produced-by": "The bank",
  "x-consumed-by": "Receipts (unmatched)",
  "x-rule": "Arrives unmatched. Nothing opens until a second hand matches it.",
  "allOf": [
    {
      "$ref": "_envelope.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "money.received"
    },
    "payload": {
      "type": "object",
      "required": [
        "utr",
        "amount",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "utr": {
          "type": "string"
        },
        "amount": {
          "type": "integer",
          "description": "Whole rupees. Never a float, never a string."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "virtual_account": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        }
      }
    }
  }
}
