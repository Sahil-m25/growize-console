{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growize.internal/contracts/push.delivered.json",
  "title": "push.delivered",
  "x-direction": "outside \u2192 investor",
  "x-produced-by": "FCM",
  "x-consumed-by": "Contact; update rows",
  "x-rule": "Delivered is a fact. Sent is not.",
  "allOf": [
    {
      "$ref": "_envelope.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "push.delivered"
    },
    "payload": {
      "type": "object",
      "required": [
        "message_id",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "to_contact_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "delivered",
            "bounced",
            "deferred"
          ]
        }
      }
    }
  }
}
