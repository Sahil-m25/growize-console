void automation.gz_sync_ir_access(String contactId)
{
// D123 Q2: Zoho shares a record read-only with the user named in LLP_UnitAllocation_Module.IR_Access (user-lookup sharing).
// Copies Contacts.Originating_IR onto the investor's allotments. Writes only what differs. Logs ids only.
// Wire to workflow rule "GZ IR Access Sync" (Contacts, on edit when Originating_IR is modified to any value, repeat on), contactId = Contacts.Contact Id.
// IR_Access is a derived copy of Originating_IR (rule 1 note: like KAM_Access, never edited by hand; Originating_IR stays the one writer).
contact = zoho.crm.getRecordById("Contacts",contactId.toLong());
irId = "";
ir = contact.get("Originating_IR");
if(ir != null)
{
	irId = ir.get("id").toString();
}
changed = 0;
stale = 0;
allots = zoho.crm.searchRecords("LLP_UnitAllocation_Module","(Customer:equals:" + contactId + ")",1,200);
for each  a in allots
{
	// IR_Access is a multi-user lookup stored as rows in its link table (SANDBOX: LLP_UnitA_X_Users, allotment lookup userlookup221_4).
	// Deluge cannot update multi-user values or delete link rows, so this ADDS the current IR when missing and REPORTS any other
	// user as stale (an admin removes it in the record; Originating_IR is admin-only and rarely changes). The nightly check reports it too.
	// List/search reads return IR_Access empty (verified 5 Oct), so read the link rows themselves.
	found = false;
	links = zoho.crm.searchRecords("LLP_UnitA_X_Users","(userlookup221_4:equals:" + a.get("id") + ")",1,200);
	for each  e in links
	{
		if(e.get("IR_Access") != null && e.get("IR_Access").get("id").toString() == irId)
		{
			found = true;
		}
		else
		{
			stale = stale + 1;
		}
	}
	if(irId != "" && !found)
	{
		lk = Map();
		lk.put("userlookup221_4",a.get("id"));
		lk.put("IR_Access",irId);
		zoho.crm.createRecord("LLP_UnitA_X_Users",lk);
		changed = changed + 1;
	}
}
info "contact " + contactId + " ir added " + changed + " stale " + stale;
}
