# Growize console — every variable the code reads (see ops/env/README.md for staging vs production).
# Copy to console/.env.local for local work. NEVER commit a filled copy (.env* is git-ignored).
# [secret] = store as a GitHub Environment secret / host secret; everything else is plain config.

# --- runtime ---------------------------------------------------------------
NODE_ENV=production

# --- Zoho OAuth (sign-in, D51/D53) -----------------------------------------
ZOHO_ACCOUNTS_ORIGIN=https://accounts.zoho.in
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=                    # [secret]
ZOHO_OAUTH_REDIRECT_URI=https://<host>/api/auth/zoho/callback
ZOHO_OAUTH_SCOPES=                           # optional, comma list; code defaults apply when empty
ZOHO_SESSION_KEY=                            # [secret] 32 random bytes, base64 (openssl rand -base64 32)
ZOHO_CRM_RECORD_ID_PREFIX=                   # the org's record-id prefix (sandbox differs from live)
ZOHO_SEAT_IDS={"roleIds":{},"profileIds":{}} # JSON: Zoho role/profile ids -> console seats
ZOHO_UNASSIGNED_QUEUE_USER_ID=

# --- Zoho Sign webhook + service credential --------------------------------
ZOHO_PROVIDER_CALLBACK_REFRESH_TOKEN=        # [secret] service job "provider-callback"
ZOHO_SIGN_API_ORIGIN=https://sign.zoho.in
ZOHO_SIGN_WEBHOOK_SECRET=                    # [secret]
ZOHO_SIGN_WEBHOOK_SECRET_PREVIOUS=           # [secret] only while rotating

# --- email send -------------------------------------------------------------
ORG_EMAIL_DOMAINS=agresearchlabs.com
FOLLOWUP_UNDO_SECRET=                        # [secret] >= 32 characters

# --- ops / logs -------------------------------------------------------------
ALERT_EMAIL_TO=
LOG_STORE=jsonl                              # memory | jsonl
LOG_DIR=                                     # required when LOG_STORE=jsonl

# --- staging only -----------------------------------------------------------
GZ_SIGNIN_LIST=                              # "staging" on staging; unset in production
JEV_SEED_TOKEN=                              # [secret] staging only; guards /api/test/*

# --- local development only (leave unset on staging and production) -------
FIXTURE_MODE=                                # "local" = fixtures, no Zoho
GZ_LOCAL_BUILD=
ZOHO_STUB_USER=
NEXT_PUBLIC_RETICLE_TOKEN=
NEXT_PUBLIC_RETICLE_URL=
NEXT_PUBLIC_RETICLE_ROOT=

# --- CI / Jev tooling (GitHub Environment "staging") -----------------------
STAGING_URL=
APP_URL=
JEV_STAGING_CONFIG=
JEV_SESSIONS_DIR=
TYPESAFE_API_KEY=                            # [secret]
TS_KEY_FILE=
FIXTURES=
ONLY=
PASS_AT=0.80
SEED_WAIT_MS=700
LEAK_MATRIX_CONFIG=
# JEV_PW_<SEAT>=                             # [secret] per seat, only if sessions are minted in CI
# NODE_PATH is set by the test harnesses themselves.

# --- one-off operator script (migrate-legacy-payments.cjs), never on a host -
ZOHO_ACCESS_TOKEN=                           # [secret]
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_RECORD_PREFIX=
