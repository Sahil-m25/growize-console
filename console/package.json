{
  "name": "@growize/console",
  "version": "0.1.0",
  "private": true,
  "description": "Growize IR lead console — the twelve pages of stage 2, built to console/prototype/ir-console.html",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "dev:local": "node -e \"process.env.FIXTURE_MODE='local';require('child_process').spawn('npx next dev -p 3001',{stdio:'inherit',shell:true,env:process.env}).on('exit',c=>process.exit(c??0))\"",
    "test": "vitest run --passWithNoTests && node --test src/lib/zoho/identity.test.cjs src/lib/zoho/zoho-lib.test.cjs"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@reticlehq/next": "^3.2.0",
    "@reticlehq/react": "^3.2.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "playwright": "^1.50.1",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  }
}
